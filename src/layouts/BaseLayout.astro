---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/ibm-plex-mono/400.css';

import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/grid.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';
import { getSwitchLocaleUrl, getTranslations, type SectionKey } from '../i18n/utils';

interface Props {
	locale: Locale;
	activeSection: SectionKey;
	title?: string;
	description?: string;
}

const { locale, activeSection, title, description } = Astro.props;
const t = getTranslations(locale);
const pageTitle = title ? `${title} — ${t.siteTitle}` : t.home.metaTitle;
const pageDescription = description ?? t.siteTagline;
const alternateHref = getSwitchLocaleUrl(Astro.url.pathname, locale);
const htmlLang = locale === 'pt-br' ? 'pt-BR' : 'en';
---

<!doctype html>
<html lang={htmlLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<link
			rel="alternate"
			hreflang={locale === 'pt-br' ? 'en' : 'pt-BR'}
			href={alternateHref}
		/>
	</head>
	<body>
		<Header locale={locale} activeSection={activeSection} currentPath={Astro.url.pathname} />
		<main>
			<slot />
		</main>
		<Footer locale={locale} currentPath={Astro.url.pathname} />
	</body>
</html>
