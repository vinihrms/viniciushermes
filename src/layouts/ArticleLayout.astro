---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n/ui';
import { getTranslations, type SectionKey } from '../i18n/utils';

interface MetaPair {
	label: string;
	value: string;
	href?: string;
}

interface Props {
	locale: Locale;
	activeSection: SectionKey;
	backHref: string;
	backLabel: string;
	eyebrow: string;
	title: string;
	lead?: string;
	cover?: ImageMetadata;
	coverAlt?: string;
	coverVariant?: 'horizontal' | 'book';
	meta?: MetaPair[];
	tags?: string[];
	quote?: string;
	isFallback?: boolean;
}

const {
	locale,
	activeSection,
	backHref,
	backLabel,
	eyebrow,
	title,
	lead,
	cover,
	coverAlt = title,
	coverVariant = 'horizontal',
	meta = [],
	tags = [],
	quote,
	isFallback = false,
} = Astro.props;

const t = getTranslations(locale);
---

<BaseLayout locale={locale} activeSection={activeSection} title={title} description={lead}>
	<article class="article-page">
		<div class="editorial-container">
			<nav class="article-back" aria-label={backLabel}>
				<a href={backHref} class="article-back__link">← {backLabel}</a>
			</nav>

			{
				isFallback && (
					<p class="article-fallback" role="note">
						{t.fallbackNotice}
					</p>
				)
			}

			{
				coverVariant === 'book' && cover ? (
					<header class="book-header">
						<div class="book-header__cover">
							<Image
								src={cover}
								alt={coverAlt}
								widths={[360, 560, 760]}
								sizes="(max-width: 767px) 70vw, 340px"
							/>
						</div>
						<div class="book-header__info">
							<span class="article-eyebrow">{eyebrow}</span>
							<h1 class="article-title">{title}</h1>
							{lead && <p class="article-lead">{lead}</p>}
							{meta.length > 0 && (
								<dl class="article-meta-grid">
									{meta.map((item) => (
										<div class="article-meta-item">
											<dt>{item.label}</dt>
											<dd>
												{item.href ? (
													<a href={item.href} target="_blank" rel="noreferrer">
														{item.value} ↗
													</a>
												) : (
													item.value
												)}
											</dd>
										</div>
									))}
								</dl>
							)}
						</div>
					</header>
				) : (
					<header class="article-header">
						<span class="article-eyebrow">{eyebrow}</span>
						<h1 class="article-title">{title}</h1>
						{lead && <p class="article-lead">{lead}</p>}

						{(meta.length > 0 || tags.length > 0) && (
							<div class="article-meta-bar">
								{meta.length > 0 && (
									<dl class="article-meta-inline">
										{meta.map((item) => (
											<div class="article-meta-item">
												<dt>{item.label}</dt>
												<dd>
													{item.href ? (
														<a href={item.href} target="_blank" rel="noreferrer">
															{item.value} ↗
														</a>
													) : (
														item.value
													)}
												</dd>
											</div>
										))}
									</dl>
								)}
								{tags.length > 0 && (
									<ul class="article-tags">
										{tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)}
							</div>
						)}

						{cover && (
							<figure class="article-cover">
								<Image
									src={cover}
									alt={coverAlt}
									widths={[640, 1024, 1440]}
									sizes="(max-width: 1024px) 100vw, 1280px"
								/>
							</figure>
						)}
					</header>
				)
			}

			<div class="article-content reading-container">
				{
					quote && (
						<blockquote class="article-epigraph">
							<p>“{quote}”</p>
						</blockquote>
					)
				}
				<div class="prose">
					<slot />
				</div>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.article-page {
		padding-block: clamp(24px, 3vw, 40px) clamp(64px, 8vw, 112px);
	}

	.article-back {
		margin-bottom: clamp(24px, 4vw, 44px);
	}

	.article-back__link {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
		transition: color var(--duration-fast) var(--ease-editorial);
	}

	.article-back__link:hover {
		color: var(--color-ink);
	}

	.article-fallback {
		margin: 0 0 24px;
		padding: 10px 14px;
		border: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-ink-secondary);
	}

	.article-header {
		margin-bottom: clamp(32px, 5vw, 56px);
	}

	.article-eyebrow {
		display: block;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 14px;
	}

	.article-title {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 400;
		font-size: var(--text-display);
		line-height: 1.04;
		letter-spacing: -0.015em;
		max-width: 22ch;
	}

	.article-lead {
		margin: 18px 0 0;
		max-width: 60ch;
		font-size: var(--text-md);
		color: var(--color-ink-secondary);
		line-height: 1.65;
	}

	.article-meta-bar {
		margin-top: 28px;
		padding-block: 16px;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px 32px;
	}

	.article-meta-inline,
	.article-meta-grid {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 16px 36px;
	}

	.article-meta-grid {
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px solid var(--color-border);
	}

	.article-meta-item dt {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-muted);
		margin-bottom: 4px;
	}

	.article-meta-item dd {
		margin: 0;
		font-size: var(--text-sm);
		color: var(--color-ink);
	}

	.article-meta-item dd a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.article-tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.article-tags li {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.08em;
		padding: 4px 10px;
		border: 1px solid var(--color-border);
		color: var(--color-ink-secondary);
	}

	.article-cover {
		margin: 28px 0 0;
		background-color: var(--color-surface);
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.article-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* Layout específico de livro (capa 2:3 + ficha editorial) */
	.book-header {
		display: grid;
		grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
		gap: clamp(24px, 4vw, 56px);
		align-items: end;
		padding-bottom: clamp(32px, 5vw, 56px);
		margin-bottom: clamp(32px, 5vw, 56px);
		border-bottom: 1px solid var(--color-border);
	}

	.book-header__cover {
		aspect-ratio: 2 / 3;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.book-header__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(100%) contrast(1.06);
	}

	.article-epigraph {
		margin: 0 0 2.5rem;
		padding: 0 0 2rem;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		line-height: 1.45;
		color: var(--color-ink);
	}

	.article-epigraph p {
		margin: 0;
	}

	@media (max-width: 767px) {
		.book-header {
			grid-template-columns: minmax(0, 1fr);
		}

		.book-header__cover {
			max-width: 260px;
		}
	}
</style>
