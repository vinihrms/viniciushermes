---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialCard from './EditorialCard.astro';
import type { Locale } from '../i18n/ui';
import { getItemUrl, getTranslations } from '../i18n/utils';
import { getLocalizedBooks } from '../lib/content';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const books = await getLocalizedBooks(locale);
const years = Array.from(new Set(books.map((b) => b.entry.data.yearRead))).sort((a, b) => b - a);
---

<BaseLayout locale={locale} activeSection="books" title={t.books.title} description={t.books.lead}>
	<div class="editorial-container">
		<header class="page-header">
			<span class="page-header__eyebrow">{t.books.eyebrow} · {books.length}</span>
			<h1 class="page-header__title">{t.books.title}</h1>
			<p class="page-header__lead">{t.books.lead}</p>
		</header>

		<div class="filter-bar" role="group" aria-label={t.books.title} data-filter-group="books">
			<button type="button" class="filter-btn" aria-pressed="true" data-filter="all">
				{t.books.allFilter} ({books.length})
			</button>
			<button type="button" class="filter-btn" aria-pressed="false" data-filter="favorite">
				{t.books.favoritesFilter}
			</button>
			{
				years.map((year) => (
					<button type="button" class="filter-btn" aria-pressed="false" data-filter={`year-${year}`}>
						{year}
					</button>
				))
			}
		</div>

		<div class="editorial-stack">
			<div class="editorial-grid editorial-grid--vertical" data-filter-grid="books">
				{
					books.map(({ entry, slug }) => {
						const filterTokens = [
							`year-${entry.data.yearRead}`,
							entry.data.favorite ? 'favorite' : '',
						]
							.filter(Boolean)
							.join(' ');

						const kickerParts = [
							entry.data.category ??
								(entry.data.status === 'lendo'
									? t.books.statusReading
									: t.books.statusRead),
							entry.data.favorite ? t.books.favoriteBadge : '',
						].filter(Boolean);

						return (
							<EditorialCard
								filterValue={filterTokens}
								card={{
									href: getItemUrl(locale, 'books', slug),
									image: entry.data.cover,
									imageAlt: entry.data.coverAlt,
									kicker: kickerParts.join(' · '),
									metaRight: entry.data.rating
										? `${entry.data.rating} · ${entry.data.yearRead}`
										: String(entry.data.yearRead),
									title: entry.data.title,
									subtitle: entry.data.author,
									mediaVariant: 'book',
									monochrome: true,
								}}
							/>
						);
					})
				}
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	const group = document.querySelector('[data-filter-group="books"]');
	const grid = document.querySelector('[data-filter-grid="books"]');
	if (group && grid) {
		const buttons = group.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const items = grid.querySelectorAll<HTMLElement>('[data-filter-item]');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const selected = btn.dataset.filter ?? 'all';
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				items.forEach((item) => {
					const tokens = (item.dataset.filterItem ?? '').split(/\s+/).filter(Boolean);
					item.hidden = selected !== 'all' && !tokens.includes(selected);
				});
			});
		});
	}
</script>
