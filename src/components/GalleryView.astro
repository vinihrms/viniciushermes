---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/ui';
import { getTranslations } from '../i18n/utils';
import { getGalleryItems, type GalleryEntry } from '../lib/content';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const items = await getGalleryItems();

// Agrupa itens consecutivos da mesma orientação em faixas:
// horizontais -> 2 colunas lado a lado; verticais -> 3 colunas lado a lado
interface GalleryBand {
	orientation: 'horizontal' | 'vertical';
	items: Array<{
		entry: GalleryEntry;
		index: number;
		title: string;
		location: string;
		fullSrc: string;
	}>;
}

const enriched = await Promise.all(
	items.map(async (entry, index) => {
		const optimized = await getImage({ src: entry.data.image, width: 1600 });
		return {
			entry,
			index,
			title: locale === 'pt-br' ? entry.data.titlePt : entry.data.titleEn,
			location:
				(locale === 'pt-br' ? entry.data.locationPt : entry.data.locationEn) ?? '',
			fullSrc: optimized.src,
		};
	})
);

const bands: GalleryBand[] = [];
for (const item of enriched) {
	const last = bands[bands.length - 1];
	if (last && last.orientation === item.entry.data.orientation) {
		last.items.push(item);
	} else {
		bands.push({
			orientation: item.entry.data.orientation,
			items: [item],
		});
	}
}
---

<BaseLayout
	locale={locale}
	activeSection="gallery"
	title={t.gallery.title}
	description={t.gallery.lead}
>
	<div class="editorial-container">
		<header class="page-header">
			<span class="page-header__eyebrow">{t.gallery.eyebrow}</span>
			<h1 class="page-header__title">{t.gallery.title}</h1>
			<p class="page-header__lead">{t.gallery.lead}</p>
		</header>

		<div class="filter-bar" role="group" aria-label={t.gallery.title} data-gallery-filter>
			<button type="button" class="filter-btn" aria-pressed="true" data-filter="all">
				{t.gallery.allFilter}
			</button>
			<button type="button" class="filter-btn" aria-pressed="false" data-filter="horizontal">
				{t.gallery.horizontalFilter}
			</button>
			<button type="button" class="filter-btn" aria-pressed="false" data-filter="vertical">
				{t.gallery.verticalFilter}
			</button>
		</div>

		<div class="editorial-stack gallery-bands" data-gallery-bands>
			{
				bands.map((band) => (
					<div
						class:list={[
							'editorial-grid',
							band.orientation === 'horizontal'
								? 'editorial-grid--horizontal'
								: 'editorial-grid--vertical',
						]}
						data-band-orientation={band.orientation}
					>
						{band.items.map((item) => (
							<figure class="editorial-card gallery-item" id={item.entry.data.id}>
								<button
									type="button"
									class="editorial-card__trigger gallery-trigger"
									data-lightbox-open
									data-index={item.index}
									data-id={item.entry.data.id}
									data-src={item.fullSrc}
									data-title={item.title}
									data-location={item.location}
									data-date={item.entry.data.date}
									data-camera={item.entry.data.camera ?? ''}
								>
									<div
										class:list={[
											'editorial-card__media',
											band.orientation === 'horizontal'
												? 'editorial-card__media--horizontal'
												: 'editorial-card__media--vertical',
										]}
									>
										<Image
											src={item.entry.data.image}
											alt={item.title}
											widths={
												band.orientation === 'horizontal'
													? [480, 760, 1080]
													: [360, 560, 800]
											}
											sizes={
												band.orientation === 'horizontal'
													? '(max-width: 639px) 100vw, 50vw'
													: '(max-width: 639px) 50vw, 33vw'
											}
											loading="lazy"
											decoding="async"
										/>
									</div>
									<figcaption class="editorial-card__body gallery-caption">
										<div class="editorial-card__meta">
											<span>{item.title}</span>
											<span>{item.entry.data.date}</span>
										</div>
										{item.location && (
											<span class="gallery-caption__sub">{item.location}</span>
										)}
									</figcaption>
								</button>
							</figure>
						))}
					</div>
				))
			}
		</div>
	</div>

	<dialog class="lightbox" data-lightbox aria-label={t.gallery.title}>
		<div class="lightbox__shell">
			<div class="lightbox__top">
				<span class="lightbox__counter" data-lightbox-counter></span>
				<button type="button" class="lightbox__action" data-lightbox-close>
					{t.gallery.close} [ESC]
				</button>
			</div>

			<div class="lightbox__stage">
				<button
					type="button"
					class="lightbox__nav"
					data-lightbox-prev
					aria-label={t.gallery.previous}
				>
					←
				</button>
				<img class="lightbox__img" src="" alt="" data-lightbox-img />
				<button
					type="button"
					class="lightbox__nav"
					data-lightbox-next
					aria-label={t.gallery.next}
				>
					→
				</button>
			</div>

			<div class="lightbox__meta">
				<div>
					<p class="lightbox__title" data-lightbox-title></p>
					<p class="lightbox__sub" data-lightbox-sub></p>
				</div>
				<span class="lightbox__camera" data-lightbox-camera></span>
			</div>
		</div>
	</dialog>
</BaseLayout>

<script>
	const filterGroup = document.querySelector('[data-gallery-filter]');
	const bandsContainer = document.querySelector('[data-gallery-bands]');

	if (filterGroup && bandsContainer) {
		const buttons = filterGroup.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const bands = bandsContainer.querySelectorAll<HTMLElement>('[data-band-orientation]');
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const selected = btn.dataset.filter ?? 'all';
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
				bands.forEach((band) => {
					band.hidden = selected !== 'all' && band.dataset.bandOrientation !== selected;
				});
			});
		});
	}

	const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
	const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));

	if (dialog && triggers.length > 0) {
		const imgEl = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]');
		const titleEl = dialog.querySelector<HTMLElement>('[data-lightbox-title]');
		const subEl = dialog.querySelector<HTMLElement>('[data-lightbox-sub]');
		const cameraEl = dialog.querySelector<HTMLElement>('[data-lightbox-camera]');
		const counterEl = dialog.querySelector<HTMLElement>('[data-lightbox-counter]');
		const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
		const prevBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
		const nextBtn = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');

		let currentIndex = 0;

		const renderItem = (index: number) => {
			currentIndex = (index + triggers.length) % triggers.length;
			const btn = triggers[currentIndex];
			if (!btn || !imgEl || !titleEl || !subEl || !cameraEl || !counterEl) return;
			imgEl.src = btn.dataset.src ?? '';
			imgEl.alt = btn.dataset.title ?? '';
			titleEl.textContent = btn.dataset.title ?? '';
			const parts = [btn.dataset.location, btn.dataset.date].filter(Boolean);
			subEl.textContent = parts.join(' · ');
			cameraEl.textContent = btn.dataset.camera ?? '';
			counterEl.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
		};

		const openAt = (index: number) => {
			renderItem(index);
			if (!dialog.open) dialog.showModal();
		};

		triggers.forEach((btn, idx) => {
			btn.addEventListener('click', () => openAt(idx));
		});

		closeBtn?.addEventListener('click', () => dialog.close());
		prevBtn?.addEventListener('click', () => renderItem(currentIndex - 1));
		nextBtn?.addEventListener('click', () => renderItem(currentIndex + 1));

		dialog.addEventListener('click', (event) => {
			if (event.target === dialog) dialog.close();
		});

		window.addEventListener('keydown', (event) => {
			if (!dialog.open) return;
			if (event.key === 'ArrowLeft') renderItem(currentIndex - 1);
			if (event.key === 'ArrowRight') renderItem(currentIndex + 1);
		});

		// Permite abrir diretamente se veio de um link /galeria#id
		const hashId = window.location.hash.replace(/^#/, '');
		if (hashId) {
			const matchIndex = triggers.findIndex((btn) => btn.dataset.id === hashId);
			if (matchIndex >= 0) openAt(matchIndex);
		}
	}
</script>

<style>
	.gallery-bands {
		gap: 28px;
	}

	.gallery-item {
		margin: 0;
	}

	.gallery-trigger {
		width: 100%;
		text-align: left;
		display: flex;
		flex-direction: column;
	}

	.gallery-caption {
		padding-top: 10px;
	}

	.gallery-caption__sub {
		font-size: var(--text-xs);
		color: var(--color-muted);
	}

	.lightbox {
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		border: none;
		padding: 0;
		margin: 0;
		background-color: var(--color-bg);
		color: var(--color-ink);
	}

	.lightbox::backdrop {
		background-color: var(--color-bg);
	}

	.lightbox__shell {
		height: 100%;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: clamp(16px, 2.5vw, 32px);
		gap: 16px;
	}

	.lightbox__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.lightbox__action:hover {
		opacity: 0.6;
	}

	.lightbox__stage {
		min-height: 0;
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr) 48px;
		align-items: center;
		gap: 12px;
	}

	.lightbox__img {
		max-height: 100%;
		max-width: 100%;
		margin-inline: auto;
		object-fit: contain;
	}

	.lightbox__nav {
		height: 48px;
		width: 48px;
		display: grid;
		place-items: center;
		font-size: 1.25rem;
		border: 1px solid var(--color-border);
		transition: border-color var(--duration-fast) var(--ease-editorial);
	}

	.lightbox__nav:hover {
		border-color: var(--color-ink);
	}

	.lightbox__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px 24px;
		padding-top: 12px;
		border-top: 1px solid var(--color-border);
	}

	.lightbox__title {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.35rem;
	}

	.lightbox__sub {
		margin: 2px 0 0;
		font-size: var(--text-xs);
		color: var(--color-muted);
	}

	.lightbox__camera {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: 0.1em;
		color: var(--color-muted);
	}

	@media (max-width: 639px) {
		.lightbox__stage {
			grid-template-columns: 36px minmax(0, 1fr) 36px;
			gap: 8px;
		}

		.lightbox__nav {
			width: 36px;
			height: 36px;
		}
	}
</style>
