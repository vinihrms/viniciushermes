---
import { render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import type { Locale } from '../i18n/ui';
import { formatEditorialDate, getSectionUrl, getTranslations } from '../i18n/utils';
import type { BookEntry } from '../lib/content';

interface Props {
	locale: Locale;
	entry: BookEntry;
	isFallback?: boolean;
}

const { locale, entry, isFallback = false } = Astro.props;
const t = getTranslations(locale);
const { Content } = await render(entry);

const statusLabel =
	entry.data.status === 'lendo' ? t.books.statusReading : t.books.statusRead;

const readValue = entry.data.completedDate
	? formatEditorialDate(entry.data.completedDate, locale)
	: String(entry.data.yearRead);

const meta = [
	{ label: t.books.author, value: entry.data.author },
	{ label: t.books.yearRead, value: readValue },
	...(entry.data.category ? [{ label: t.books.category, value: entry.data.category }] : []),
	...(entry.data.pages ? [{ label: t.books.pages, value: String(entry.data.pages) }] : []),
	...(entry.data.rating ? [{ label: t.books.rating, value: entry.data.rating }] : []),
];

const eyebrowParts = [
	t.books.eyebrow,
	statusLabel,
	entry.data.favorite ? t.books.favoriteBadge : '',
].filter(Boolean);

const extraQuotes = entry.data.quotes ?? [];
---

<ArticleLayout
	locale={locale}
	activeSection="books"
	backHref={getSectionUrl(locale, 'books')}
	backLabel={t.books.backToList}
	eyebrow={eyebrowParts.join(' · ')}
	title={entry.data.title}
	lead={entry.data.excerpt}
	cover={entry.data.cover}
	coverAlt={entry.data.coverAlt}
	coverVariant="book"
	meta={meta}
	quote={entry.data.quote}
	isFallback={isFallback}
>
	<Content />
	{
		extraQuotes.length > 0 && (
			<section class="book-quotes">
				<h2>{t.books.quotesTitle}</h2>
				{extraQuotes.map((q) => (
					<blockquote>
						<p>“{q}”</p>
					</blockquote>
				))}
			</section>
		)
	}
</ArticleLayout>
